# ─────────────────────────────────────────────────────────────────────────
#  Configuração da Plataforma LGPD — copie para .env e ajuste o necessário
# ─────────────────────────────────────────────────────────────────────────

# Chave usada para assinar sessões e tokens CSRF.
# Em produção, gere uma forte:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# Banco de dados.
#   - Deixe em branco para usar SQLite local (instance/lgpd.db) — zero configuração.
#   - Para PostgreSQL (VPS / produção):
#       DATABASE_URL=postgresql://usuario:senha@localhost:5432/lgpd
# DATABASE_URL=

# Cookies de sessão apenas via HTTPS (ative em produção atrás de HTTPS).
SESSION_COOKIE_SECURE=false

# Regras de avaliação (podem ser sobrescritas aqui).
NOTA_CORTE=70
QUESTOES_POR_PROVA=8
CERT_VALIDADE_DIAS=365
TEMPO_PROVA_MIN=15          # tempo da prova em minutos (0 = sem limite)

# Bloqueio de conta por tentativas de login malsucedidas.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MIN=15

# Rate limit: em branco usa memória; para multi-worker, aponte para Redis.
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# E-mail (notificações). Sem MAIL_SERVER, o envio roda em modo "dry-run" (só loga).
# MAIL_SERVER=smtp.exemplo.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=nao-responder@suaempresa.com.br

# Reavaliação: dias antes do vencimento que contam como "vencendo".
REAVALIACAO_DIAS=30

# Feed RSS de legislação/notícias (ANPD). Vazio = só referências fixas.
# FEED_URL=

# Logging em arquivo (rotação). Vazio mantém só o stdout.
LOG_FILE=logs/app.log
