# ─────────────────────────────────────────────────────────────────────────
#  Configuração da Plataforma LGPD — copie para .env e ajuste o necessário
# ─────────────────────────────────────────────────────────────────────────

# Chave usada para assinar sessões e tokens CSRF.
#   - Em branco: o app gera uma chave aleatória e a guarda em instance/secret_key
#     (fora do git) — suficiente para demo/local.
#   - Em produção, defina explicitamente uma chave forte:
#       python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Banco de dados.
#   - Deixe em branco para usar SQLite local (instance/lgpd.db) — zero configuração.
#   - Para PostgreSQL (VPS / produção):
#       DATABASE_URL=postgresql://usuario:senha@localhost:5432/lgpd
# DATABASE_URL=

# Cookies de sessão apenas via HTTPS (ative em produção atrás de HTTPS).
# Com "true" o app também envia o cabeçalho HSTS.
SESSION_COOKIE_SECURE=false

# Atrás de proxy reverso (nginx, load balancer), informe quantos saltos confiar
# em X-Forwarded-For/Proto/Host — normalmente 1. Sem isso, o rate limit e o IP
# da trilha de auditoria enxergam só o IP do proxy. 0 = sem proxy.
PROXY_FIX_HOPS=0

# Debugger/reloader do Werkzeug para `python app.py` (só em desenvolvimento).
# FLASK_DEBUG=1

# Regras de avaliação (podem ser sobrescritas aqui).
NOTA_CORTE=70
QUESTOES_POR_PROVA=7          # da área do setor
QUESTOES_GERAIS_POR_PROVA=3   # da área Geral (toda prova tem as duas partes)
POOL_MINIMO_FATOR=2           # o banco da área precisa ter 2x o sorteado, senão a prova não abre
PROVAS_POR_DIA=3              # tentativas por colaborador por dia
CERT_VALIDADE_DIAS=365
TEMPO_PROVA_MIN=15          # tempo da prova em minutos (0 = sem limite)

# Bloqueio de conta por tentativas de login malsucedidas.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MIN=15

# Rate limit: em branco usa memória; para multi-worker, aponte para Redis.
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# E-mail (notificações). Sem MAIL_SERVER, o envio roda em modo "dry-run" (só loga).
# MAIL_SERVER=smtp.exemplo.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=nao-responder@suaempresa.com.br

# Reavaliação: dias antes do vencimento que contam como "vencendo".
REAVALIACAO_DIAS=30

# Retenção dos dados da própria plataforma, em dias (`flask expurgar`). 0 = nunca.
AUDITORIA_RETENCAO_DIAS=0
EMAILS_RETENCAO_DIAS=90

# Anexos (evidências): tamanho máximo por arquivo, em MB, e pasta (vazio = instance/uploads).
ANEXO_MAX_MB=5
# ANEXOS_DIR=

# Feed RSS de legislação/notícias (ANPD). Vazio = só referências fixas.
# FEED_URL=

# Logging em arquivo (rotação). Vazio mantém só o stdout.
LOG_FILE=logs/app.log
